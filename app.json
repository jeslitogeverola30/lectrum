{
  "expo": {
    "name": "Lectrum",
    "slug": "lectrum",
    "scheme": "lectrum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/lectrum_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo/lectrum_logo_noBG.png",
      "resizeMode": "contain",
      "backgroundColor": "#f07167"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/lectrum_logo_noBG.png",
        "backgroundColor": "#f07167"
      }
    },
    "web": {
      "favicon": "./assets/logo/lectrum_logo.png"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
